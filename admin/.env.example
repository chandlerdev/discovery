# Spring Boot backend URL — used by the API client
NEXT_PUBLIC_API_URL=https://discovery.desss-portfolio.com

# Where the PUBLIC questionnaire site lives. The Clients tab builds each client's link as
# ${NEXT_PUBLIC_SITE_URL}/q/<client-id>, so this must point at the frontend app, NOT at the
# admin app. Miss it and it falls back to localhost:3000 — links that work nowhere but the
# developer's machine.
NEXT_PUBLIC_SITE_URL=https://discovery.desss-portfolio.com

NEXT_PUBLIC_APP_NAME=DESSS Internal Portal
